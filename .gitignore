# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Python Virtual Environments
.venv/
.venv*/
venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook Checkpoints & Cache
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# PyTorch & Model Artifacts (Ignore large binary weights from Git tracking)
models/*.pth
models/*.onnx
models/*.pt
models/*.bin
models/*.safetensors

# Dataset files (Keep directory structure via .gitkeep, ignore actual images)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Environment variables & secrets
.env
.env.local
*.env

# IDEs & Code Editors
.vscode/
.idea/
*.swp
*.swo

# Docker / OS Junk
.DS_Store
Thumbs.db
*.log

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
